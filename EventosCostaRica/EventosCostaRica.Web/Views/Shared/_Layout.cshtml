@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdministrador = User.IsInRole("Administrador");
    var enLogin = controlador == "Cuenta" && accion == "Login";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0a12" />
    <title>@ViewData["Title"] - Eventos Costa Rica</title>
    <link rel="icon" type="image/svg+xml" href="~/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg mb-4">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/logo.svg" width="36" height="36" alt="" />
                <span class="marca">Eventos <span class="marca-resaltada">Costa Rica</span></span>
            </a>

            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link @(controlador == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a>
                </li>

                @if (autenticado)
                {
                    <li class="nav-item">
                        <a class="nav-link @(controlador == "Eventos" ? "active" : "")" asp-controller="Eventos" asp-action="Index">Eventos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(accion == "MisBoletos" ? "active" : "")" asp-controller="Entradas" asp-action="MisBoletos">Mis boletos</a>
                    </li>

                    @if (esAdministrador)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "AdminEventos" ? "active" : "")" asp-controller="AdminEventos" asp-action="Index">Administrar eventos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "AdminUsuarios" ? "active" : "")" asp-controller="AdminUsuarios" asp-action="Index">Usuarios</a>
                        </li>
                    }
                }
            </ul>

            @if (autenticado)
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="small">
                        @User.Identity!.Name
                        <span class="badge rounded-pill ms-1">@(esAdministrador ? "Administrador" : "Cliente")</span>
                    </span>
                    <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                    </form>
                </div>
            }
            else if (!enLogin)
            {
                <a class="btn btn-sm btn-primary" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
            }
        </div>
    </nav>

    <main class="container">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="pie">
        Eventos Costa Rica &copy; @DateTime.Now.Year &middot; Compra de entradas
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>