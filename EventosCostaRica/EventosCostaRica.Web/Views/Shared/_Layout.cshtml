@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdministrador = User.IsInRole("Administrador");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Eventos Costa Rica</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Eventos" asp-action="Index">Eventos Costa Rica</a>

            @if (autenticado)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(controlador == "Eventos" ? "active" : "")" asp-controller="Eventos" asp-action="Index">Eventos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(accion == "MisBoletos" ? "active" : "")" asp-controller="Entradas" asp-action="MisBoletos">Mis boletos</a>
                    </li>
                    @if (esAdministrador)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "AdminEventos" ? "active" : "")" asp-controller="AdminEventos" asp-action="Index">Administrar eventos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "AdminUsuarios" ? "active" : "")" asp-controller="AdminUsuarios" asp-action="Index">Usuarios</a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-3 text-white">
                    <span class="small">
                        @User.Identity!.Name
                        <span class="badge rounded-pill text-bg-light ms-1">@(esAdministrador ? "Administrador" : "Cliente")</span>
                    </span>
                    <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main class="container">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="pie">
        Eventos Costa Rica &copy; @DateTime.Now.Year - Compra de entradas
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
