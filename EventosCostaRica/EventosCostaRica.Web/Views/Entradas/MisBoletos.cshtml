@model List<BoletoViewModel>
@{
    ViewData["Title"] = "Mis boletos";
}

<h1 class="h3 mb-4">Mis boletos</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Todavía no ha comprado boletos. <a asp-controller="Eventos" asp-action="Index">Ver próximos eventos</a>.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var boleto in Model)
        {
            <div class="col">
                <div class="boleto h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <h2 class="h5 mb-1">@boleto.EventoNombre</h2>
                        @if (boleto.Finalizado)
                        {
                            <span class="badge text-bg-secondary">Finalizado</span>
                        }
                    </div>
                    <p class="evento-dato mb-1">@boleto.FechaEventoTexto</p>
                    <p class="evento-dato mb-3">@boleto.Lugar</p>

                    <div class="text-muted small mb-1">Asientos (@boleto.Asientos.Count)</div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var asiento in boleto.Asientos)
                        {
                            <span class="ficha-asiento">@asiento</span>
                        }
                    </div>

                    <div class="text-muted small">Comprado el @boleto.FechaCompraTexto</div>
                </div>
            </div>
        }
    </div>
}
