@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3 text-center">Iniciar sesión</h1>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autocomplete="username" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Contrasena" class="form-label"></label>
                <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>

        <p class="text-muted small text-center mt-3">
            Usuarios de prueba:<br />
            admin@eventoscr.com / Admin123!<br />
            cliente@eventoscr.com / Cliente123!
        </p>
    </div>
</div>
