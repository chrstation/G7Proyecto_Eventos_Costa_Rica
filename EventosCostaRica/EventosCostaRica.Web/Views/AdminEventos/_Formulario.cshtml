@model EventoViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-7">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="FechaEvento" class="form-label"></label>
        <input asp-for="FechaEvento" class="form-control" type="datetime-local" />
        <span asp-validation-for="FechaEvento" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Lugar" class="form-label"></label>
        <input asp-for="Lugar" class="form-control" />
        <span asp-validation-for="Lugar" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="BannerUrl" class="form-label"></label>
        <input asp-for="BannerUrl" class="form-control" placeholder="https://..." />
        <span asp-validation-for="BannerUrl" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
</div>
