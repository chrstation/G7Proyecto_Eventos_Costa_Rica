@model List<EventoViewModel>
@{
    ViewData["Title"] = "Administrar eventos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Administración de eventos</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo evento</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay eventos registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Fecha</th>
                    <th>Lugar</th>
                    <th>Vendidas</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evento in Model)
                {
                    <tr>
                        <td>@evento.Nombre</td>
                        <td>@evento.FechaCorta</td>
                        <td>@evento.Lugar</td>
                        <td>
                            @evento.EntradasVendidas / @(Evento.Capacidad)
                            @if (evento.Agotado)
                            {
                                <span class="badge text-bg-danger ms-1">Agotado</span>
                            }
                            else if (evento.Finalizado)
                            {
                                <span class="badge text-bg-secondary ms-1">Finalizado</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Eventos" asp-action="Detalle" asp-route-id="@evento.Id">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@evento.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@evento.Id">Borrar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
